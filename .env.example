# ──────────────────────────────────────────────
# Tzeva Best — Environment Variables
# Copy to .env and adjust values as needed.
# ──────────────────────────────────────────────

# ── Spring ────────────────────────────────────
# Active profile: local | test | prod
SPRING_PROFILES_ACTIVE=local

# ── PostgreSQL ────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tzevabest
DB_USERNAME=tzevabest
DB_PASSWORD=tzevabest_secret

# DB_POOL_MAX_SIZE=20       # prod only: max HikariCP connections
# DB_POOL_MIN_IDLE=5        # prod only: min idle HikariCP connections

# ── Redis ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=             # leave empty for local; set if Redis requires auth

# ── S3 / MinIO (media storage) ────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=tzevabest-media
# Приватный бакет для фото заявок клиентов (персональные данные) — выдача по presigned GET
S3_BUCKET_PRIVATE=tzevabest-private
S3_REGION=us-east-1
# Path-style URLs required for MinIO; set false for real AWS S3
S3_PATH_STYLE=true

# ── Mail (Mailpit in local, real SMTP in prod) ─
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@tzevabest.co.il
# SMTP auth/TLS: false for Mailpit (local), true for a real SMTP provider (prod)
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# ── Mailpit UI (local only) ───────────────────
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# ── Application ───────────────────────────────
SERVER_PORT=8080
# VAT rate for Israel (ma'am), 18%
APP_VAT_RATE=0.18
