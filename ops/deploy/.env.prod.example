# ── Прод-окружение VM (скопировать в ops/deploy/.env на сервере, заполнить) ──────
# НЕ коммитить .env. Секреты — длинные случайные (>=32 символов для подписей).

# ── Образы (из GHCR; main.yml публикует бэкенд, /web, /admin) ─────────────────────
REGISTRY_IMAGE=ghcr.io/<owner>/<repo>
IMAGE_TAG=latest            # или sha-<commit> для детерминизма

# ── Домены (публичные A/AAAA на эту VM; Caddy выпустит TLS) ───────────────────────
API_DOMAIN=api.example.co.il
WEB_DOMAIN=example.co.il
ADMIN_DOMAIN=admin.example.co.il
MEDIA_DOMAIN=media.example.co.il

# ── Профиль/миграции ──────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── PostgreSQL (контейнер в этом же compose) ──────────────────────────────────────
DB_NAME=tzevabest
DB_USERNAME=tzevabest
DB_PASSWORD=__CHANGE_ME__

# ── Redis ──────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=__CHANGE_ME__

# ── S3/MinIO (медиа) ────────────────────────────────────────────────────────────────
S3_ACCESS_KEY=__CHANGE_ME__
S3_SECRET_KEY=__CHANGE_ME__
S3_BUCKET=tzevabest-media
S3_BUCKET_PRIVATE=tzevabest-private
S3_REGION=us-east-1
# Endpoint ДОЛЖЕН быть доступен браузеру (presigned-ссылки подписаны под него).
# MinIO на этой VM: https://${MEDIA_DOMAIN}. Managed S3: его endpoint. Публичная база — тот же хост.
S3_ENDPOINT=https://media.example.co.il
S3_PUBLIC_BASE_URL=https://media.example.co.il

# ── Почта (реальный SMTP-провайдер; домен с SPF/DKIM/DMARC) ───────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.co.il
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ── Секреты приложения (без дефолтов; ProdSecretsGuard не даст стартовать с dev/пустыми) ─
JWT_SECRET=__CHANGE_ME_32+__
NOTIFICATION_WEBHOOK_SECRET=__CHANGE_ME_32+__
NOTIFICATION_UNSUBSCRIBE_SECRET=__CHANGE_ME_32+__
SPAM_SIGNING_SECRET=__CHANGE_ME_32+__
PRIVACY_PSEUDONYM_SECRET=__CHANGE_ME_32+__

# ── URL для ссылок в письмах ────────────────────────────────────────────────────────
APP_BASE_URL=https://api.example.co.il
APP_ADMIN_URL=https://admin.example.co.il
APP_STOREFRONT_URL=https://example.co.il

# ── Сеть / прокси ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://example.co.il,https://admin.example.co.il
# Подсеть compose-сети internal (см. docker-compose.prod.yml) — с неё приходит X-Forwarded-* от Caddy.
TRUSTED_PROXIES=172.28.0.0/16

# ── Первый администратор (создаётся один раз на пустой БД) ───────────────────────────
BOOTSTRAP_ADMIN_EMAIL=admin@example.co.il
BOOTSTRAP_ADMIN_PASSWORD=__CHANGE_ME__

# ── WhatsApp (опционально; по умолчанию выключен) ────────────────────────────────────
NOTIFICATION_WHATSAPP_ENABLED=false
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
