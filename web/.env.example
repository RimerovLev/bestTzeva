# Базовый URL API бэкенда (Spring Boot). На рантайме, не в бандл.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Публичный адрес витрины — для canonical, hreflang и sitemap (F-5.2).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Аналитика Plausible (без cookies — баннер согласия не нужен). Пусто — аналитика выключена.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Свой сервер Plausible (необязательно); по умолчанию https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SRC=

# Реквизиты для разметки LocalBusiness на главной. Пусто — поле не выводится (без заглушек в Google).
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_STREET=
NEXT_PUBLIC_BUSINESS_CITY=
NEXT_PUBLIC_BUSINESS_POSTAL_CODE=
# schema.org openingHours, напр. "Su-Th 08:00-18:00"
NEXT_PUBLIC_BUSINESS_HOURS=
# города обслуживания через запятую; пусто — вся страна
NEXT_PUBLIC_BUSINESS_AREA=
